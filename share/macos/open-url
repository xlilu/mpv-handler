#!/bin/sh
set -eu

bin="${0%/*}/../MacOS"
# Terminal opens this file without arguments. Shell exec preserves the debug entry name.
if [ "$#" -eq 0 ]; then
    exec "$bin/mpv-handler-debug"
fi
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
case $1 in
    mpv-handler-debug://*)
        exec /usr/bin/open -n -b com.apple.Terminal \
            --env "MPV_HANDLER_URL=$1" --env "MPV_HANDLER_PATH=$PATH" \
            --env "MPV_HANDLER_XDG=${XDG_CONFIG_HOME:-}" "$0"
        ;;
esac

exec "$bin/mpv-handler" "$1"
