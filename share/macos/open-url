#!/bin/sh
set -eu

[ "$#" -gt 0 ] || exit 0
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
case $1 in
    mpv-handler-debug://*)
        umask 077
        root="$HOME/Library/Caches/mpv-handler/requests"
        /bin/mkdir -p "$root"
        [ ! -L "$root" ] && [ -O "$root" ] && [ "$(/usr/bin/stat -f %Lp "$root")" = 700 ] || exit 1
        dir=$(/usr/bin/mktemp -d "$root/request.XXXXXXXX")
        trap '/bin/rm -f "$dir/request"; /bin/rmdir "$dir" 2>/dev/null || :' EXIT
        printf '%s\0' "$1" "$PATH" "${XDG_CONFIG_HOME:-}" > "$dir/request"
        /usr/bin/open -b com.apple.Terminal "$dir"
        trap - EXIT
        ;;
    *) exec "${0%/*}/../MacOS/mpv-handler" "$1" ;;
esac
