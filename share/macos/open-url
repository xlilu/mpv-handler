#!/bin/sh
set -eu

handler="${0%/*}/../MacOS/mpv-handler"
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"

case ${1-} in
    mpv-handler-debug://*)
        exec /usr/bin/osascript -l JavaScript "${0%/*}/iterm-window.js" \
            "PATH=$PATH" "XDG_CONFIG_HOME=${XDG_CONFIG_HOME-}" "$handler" "$1"
        ;;
esac

exec "$handler" "$@"
