#!/bin/bash
set -eu

if [[ $# -eq 0 ]]; then
    [[ ${0##*/} == play.command ]] || exit 0
    dir=${0%/*}
    # Only the first delivery of this document can claim the request.
    /bin/mv "$dir/request" "$dir/playing" 2>/dev/null || exit 0
    {
        /bin/rm -f "$0" "$dir/playing"
        /bin/rmdir "$dir" 2>/dev/null || :
        IFS= read -r -d '' handler
        IFS= read -r -d '' url
        IFS= read -r -d '' PATH
        IFS= read -r -d '' XDG_CONFIG_HOME
    } < "$dir/playing"
    export PATH XDG_CONFIG_HOME
    if [[ -t 1 ]]; then
        printf '\033[2J\033[3J\033[H'
    fi
    exec "$handler" "$url"
fi

handler="${0%/*}/../MacOS/mpv-handler"
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
if [[ $1 != mpv-handler-debug://* ]]; then
    exec "$handler" "$1"
fi

umask 077
dir=$(/usr/bin/mktemp -d -t mpv-handler)
trap '/bin/rm -f "$dir/play.command" "$dir/request"; /bin/rmdir "$dir" 2>/dev/null || :' EXIT
/usr/bin/install -m 700 "$0" "$dir/play.command"
printf '%s\0' "$handler" "$1" "$PATH" "${XDG_CONFIG_HOME:-}" > "$dir/request"
/usr/bin/open -b com.apple.Terminal "$dir/play.command"
trap - EXIT
